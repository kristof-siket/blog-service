{
  "name": "typescript-graphql",
  "scripts": {
    "dev": "ts-node-dev  --no-notify --respawn --transpile-only src/core/server",
    "start": "node dist/core/server.js",
    "build": "tsc",
    "seed": "tsx prisma/seed.ts"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "dependencies": {
    "@apollo/server": "^4.9.5",
    "@apollo/subgraph": "^2.6.2",
    "@prisma/composer": "0.38.0",
    "@prisma/composer-prisma-cloud": "0.38.0",
    "@prisma/orm-postgres": "8.0.0-rc.23",
    "effect": "4.0.5",
    "graphql": "16.8.1",
    "graphql-scalars": "1.22.4",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prisma": "8.0.0-rc.33",
    "ts-node": "10.9.1",
    "ts-node-dev": "2.0.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "effect": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@effect/platform-bun": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@effect/platform-node-shared": "4.0.5"
  }
}
